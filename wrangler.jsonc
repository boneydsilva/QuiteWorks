{
  // Cloudflare Workers static-assets config.
  //
  // The dashboard already knows to publish ./public, but it cannot be told
  // there what to do with a URL that matches nothing. Without the
  // not_found_handling line below, a missing page returns an empty 404 body
  // and the visitor sees the browser's own error page instead of ours.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiteworks",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    // Serve public/404.html (with a 404 status) for anything not found.
    "not_found_handling": "404-page"
  }
}
